{
  "$schema": "schemas/config.schema.json",
  "build": "",
  "default_grammar": "1",
  "versions": [1, 2, 3, 4, 5],
  "out_dir": "{root}/test/build",
  "stages": {
    "lexer": {
      "cmd": ["python3.12", "-m", "nsl_compiler", "-g", "{grammar}", "{input}", "{tokens_out}"],
      "out": "{tokens_out}",
      "preprocess": [
        {"type": "json", "keep": ["kind", "line", "column"]}
      ]
    },
    "parser": {
      "cmd": ["python3.12", "-m", "nsl_compiler", "-g", "{grammar}", "-a", "{input}", "{ast_out}"],
      "out": "{ast_out}",
      "preprocess": [
        {"type": "json", "keep": ["kind", "line", "column", "elems"]}
      ]
    },
    "llvm": {
      "cmd": ["python3.12", "-m", "nsl_compiler", "-g", "{grammar}", "-o", "{llvm_out}", "{input}"],
      "out": "{llvm_out}",
      "preprocess": [
        {"type": "llvm"}
      ]
    },
    "compiler": {
      "cmd": ["python3.12", "-m", "nsl_compiler", "-g", "{grammar}", "-o", "{exe}", "{input}"]
    },
    "run": {
      "cmd": ["{exe}"],
      "out": "stdout"
    }
  },
  "llvm_dis": "llvm-dis",
  "fuzz": {
    "grammar": {
      "1": "doc/grammar1.g4",
      "2": "doc/grammar2.g4",
      "3": "doc/grammar3.g4",
      "4": "doc/grammar4.g4",
      "5": "doc/grammar5.g4"
    },
    "count": 40,
    "max_tokens": 30,
    "exit": { "lexer": 0 },
    "stages": ["lexer"]
  }
}
